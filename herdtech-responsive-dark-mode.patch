+}
+
+/* Navbars + sidebar */
+body.dark-mode .navbar,
+body.dark-mode .sidebar {
+    background-color: var(--ht-panel-dark) !important;
+    color: var(--ht-text-dark);
+    border-color: var(--ht-border-dark) !important;
+}
+
+/* Cartes (blanches en mode clair) */
+body.dark-mode .card {
+    background-color: var(--ht-card-dark) !important;
+    color: var(--ht-text-dark);
+}
+
+/* Blocs colores en inline style (#EDEDED / #D2D2D2 / #ffff / blanc) */
+body.dark-mode [style*="background-color: #EDEDED"],
+body.dark-mode [style*="background-color:#EDEDED"],
+body.dark-mode [style*="background-color: #D2D2D2"],
+body.dark-mode [style*="background-color:#D2D2D2"],
+body.dark-mode [style*="background-color: #ffff"],
+body.dark-mode [style*="background-color:#ffff"],
+body.dark-mode [style*="background-color: #fff"],
+body.dark-mode [style*="background-color:#fff"] {
+    background-color: var(--ht-card-dark) !important;
+    color: var(--ht-text-dark) !important;
+}
+
+body.dark-mode .bg-white,
+body.dark-mode .bg-light {
+    background-color: var(--ht-card-dark) !important;
+    color: var(--ht-text-dark) !important;
+}
+
+body.dark-mode .table {
+    color: var(--ht-text-dark);
+    --bs-table-color: var(--ht-text-dark);
+    --bs-table-bg: transparent;
+    --bs-table-striped-bg: rgba(255, 255, 255, 0.05);
+    --bs-table-hover-bg: rgba(255, 255, 255, 0.08);
+    border-color: var(--ht-border-dark);
+}
+
+body.dark-mode .form-control,
+body.dark-mode .form-select {
+    background-color: #2A2A2A;
+    color: var(--ht-text-dark);
+    border-color: #444;
+}
+
+body.dark-mode .form-control::placeholder {
+    color: var(--ht-muted-dark);
+}
+
+body.dark-mode .form-control:focus,
+body.dark-mode .form-select:focus {
+    background-color: #2A2A2A;
+    color: var(--ht-text-dark);
+}
+
+body.dark-mode a,
+body.dark-mode .text-dark {
+    color: var(--ht-text-dark) !important;
+}
+
+body.dark-mode .text-muted {
+    color: var(--ht-muted-dark) !important;
+}
+
+body.dark-mode hr,
+body.dark-mode .border,
+body.dark-mode .border-top,
+body.dark-mode .border-bottom {
+    border-color: var(--ht-border-dark) !important;
+}
+
+/* Icones / logos SVG au fill sombre code en dur : on les inverse pour
+   qu'elles restent visibles sur fond sombre. */
+body.dark-mode img.icon-invert,
+body.dark-mode svg.icon-invert {
+    filter: invert(1) brightness(1.4);
+}
+
+/* Menus deroulants */
+body.dark-mode .dropdown-menu {
+    background-color: var(--ht-card-dark);
+    border-color: var(--ht-border-dark);
+}
+
+body.dark-mode .dropdown-item {
