+    color: var(--ht-text-dark);
+    border-color: var(--ht-border-dark);
+}
+
+body.dark-mode .modal-header,
+body.dark-mode .modal-footer {
+    border-color: var(--ht-border-dark);
+}
+
+/* Champs "outlined" (Login / Signin) */
